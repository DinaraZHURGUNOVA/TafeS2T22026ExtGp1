<Page
    x:Class="Calculator.Currency"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Calculator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

	<Grid>
		<StackPanel
            Width="500"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

			<!-- Page heading -->
			<TextBlock
                Text="Currency Conversion Calculator"
                FontSize="28"
                TextAlignment="Center"
                Margin="0,0,0,30"/>

			<!-- Amount input -->
			<TextBlock
                Text="Amount"
                FontSize="16"
                Margin="0,0,0,8"/>

			<TextBox
                x:Name="exchangeAmountTextBox"
                PlaceholderText="Enter amount"
                FontSize="16"
                InputScope="Number"
                Margin="0,0,0,20"/>

			<!-- Currency selection -->
			<Grid Margin="0,0,0,24">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="20"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<TextBlock
                        Text="From"
                        FontSize="16"
                        Margin="0,0,0,8"/>

					<ComboBox
                        x:Name="currencyFromComboBox"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0">

						<ComboBoxItem Content="USD - US Dollar"/>
						<ComboBoxItem Content="EUR - Euro"/>
						<ComboBoxItem Content="GBP - British Pound"/>
						<ComboBoxItem Content="INR - Indian Rupee"/>
					</ComboBox>
				</StackPanel>

				<StackPanel Grid.Column="2">
					<TextBlock
                        Text="To"
                        FontSize="16"
                        Margin="0,0,0,8"/>

					<ComboBox
                        x:Name="currencyToComboBox"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="1">

						<ComboBoxItem Content="USD - US Dollar"/>
						<ComboBoxItem Content="EUR - Euro"/>
						<ComboBoxItem Content="GBP - British Pound"/>
						<ComboBoxItem Content="INR - Indian Rupee"/>
					</ComboBox>
				</StackPanel>
			</Grid>

			<!-- Conversion results -->
			<TextBlock
                Text="Conversion Result"
                FontSize="18"
                FontWeight="SemiBold"
                Margin="0,0,0,12"/>

			<TextBlock
                x:Name="fromAmountAndCurrencyTextBlock"
                Text="Original amount will appear here."
                FontSize="16"
                Margin="0,0,0,16"
                TextWrapping="Wrap"/>

			<TextBlock
                x:Name="toAmountAndCurrencyTextBlock"
                Text="Converted amount will appear here."
                FontSize="22"
                FontWeight="Bold"
                Margin="0,0,0,24"
                TextWrapping="Wrap"/>

			<!-- Exchange rates -->
			<TextBlock
                x:Name="exchangeRateTextBlock"
                Text="Forward exchange rate will appear here."
                FontSize="14"
                Margin="0,0,0,12"
                TextWrapping="Wrap"/>

			<TextBlock
                x:Name="flipExchangeRateTextBlock"
                Text="Reverse exchange rate will appear here."
                FontSize="14"
                Margin="0,0,0,24"
                TextWrapping="Wrap"/>

			<!-- Action buttons -->
			<Button
                x:Name="currencyCalcButton"
                Content="Calculate Currency"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,12"
				Click="currencyCalcButtonClick"/>

			<Button
                x:Name="backToMainMenuButton"
                Content="Back to Main Menu"
                HorizontalAlignment="Stretch"/>

		</StackPanel>
	</Grid>


</Page>
