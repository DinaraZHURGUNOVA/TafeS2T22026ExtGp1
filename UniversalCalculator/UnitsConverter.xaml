<Page
    x:Class="Calculator.UnitsConverter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">

	<Page.Resources>
		<Style TargetType="Button">
			<Setter Property="Background" Value="#AAADAF"/>
			<Setter Property="Foreground" Value="Black"/>
			<Setter Property="FontSize" Value="24"/>
			<Setter Property="Padding" Value="24,14"/>
			<Setter Property="MinWidth" Value="120"/>
			<Setter Property="BorderBrush" Value="Black"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
	</Page.Resources>

	<Grid Background="#D6D9DC">
		<ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalContentAlignment="Center">

			<Grid
                Width="900"
                MaxWidth="900"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBlock
                    Grid.Row="0"
                    Text="Units Converter"
                    FontSize="44"
                    FontWeight="Bold"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Margin="0,0,0,40"/>

				<Grid Grid.Row="1" Margin="0,0,0,28">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*"/>
						<ColumnDefinition Width="3*"/>
					</Grid.ColumnDefinitions>

					<TextBlock
                        Text="Conversion:"
                        FontSize="28"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Margin="0,0,24,0"/>

					<ComboBox
                        x:Name="ConversionBox"
                        Grid.Column="1"
                        SelectedIndex="0"
                        FontSize="22"
                        MinHeight="48"
                        Background="#E6E7E8"
                        BorderBrush="Black"
                        BorderThickness="1"
                        HorizontalAlignment="Stretch">

						<ComboBoxItem Content="Celsius to Fahrenheit"/>
						<ComboBoxItem Content="Fahrenheit to Celsius"/>
						<ComboBoxItem Content="Metres to Feet"/>
						<ComboBoxItem Content="Feet to Metres"/>
						<ComboBoxItem Content="Kilograms to Pounds"/>
						<ComboBoxItem Content="Pounds to Kilograms"/>
						<ComboBoxItem Content="Kilopascals to PSI"/>
						<ComboBoxItem Content="PSI to Kilopascals"/>
					</ComboBox>
				</Grid>

				<Grid Grid.Row="2" Margin="0,0,0,28">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*"/>
						<ColumnDefinition Width="3*"/>
					</Grid.ColumnDefinitions>

					<TextBlock
                        Text="Value to convert:"
                        FontSize="28"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Margin="0,0,24,0"/>

					<TextBox
                        x:Name="ValueBox"
                        Grid.Column="1"
                        FontSize="24"
                        MinHeight="48"
                        Background="#E6E7E8"
                        BorderBrush="Black"
                        BorderThickness="1"
                        AutomationProperties.Name="Value to convert"/>
				</Grid>

				<Grid Grid.Row="3" Margin="0,0,0,16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*"/>
						<ColumnDefinition Width="3*"/>
					</Grid.ColumnDefinitions>

					<TextBlock
                        Text="Result:"
                        FontSize="28"
                        VerticalAlignment="Center"
                        Margin="0,0,24,0"/>

					<Border
                        Grid.Column="1"
                        Background="#E6E7E8"
                        BorderBrush="Black"
                        BorderThickness="1"
                        MinHeight="56"
                        Padding="12">

						<TextBlock
                            x:Name="ResultText"
                            Text="Your result will appear here."
                            FontSize="24"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"/>
					</Border>
				</Grid>

				<TextBlock
                    x:Name="ErrorText"
                    Grid.Row="4"
                    Foreground="#B00020"
                    FontSize="20"
                    TextWrapping="Wrap"
                    Margin="0,0,0,24"/>

				<StackPanel
                    Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,24">

					<Button
                        x:Name="ConvertButton"
                        Content="Convert"
                        Margin="0,0,16,0"/>

					<Button
                        x:Name="ClearButton"
                        Content="Clear"
                        Margin="0,0,16,0"/>

					<Button
                        Content="Exit"
                        Click="ExitButton_Click"/>
				</StackPanel>
			</Grid>
		</ScrollViewer>
	</Grid>
</Page>