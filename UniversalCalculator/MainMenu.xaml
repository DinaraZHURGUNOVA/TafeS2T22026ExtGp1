<Page
    x:Class="Calculator.MainMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<StackPanel
            Width="300"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

			<TextBlock
                Text="Universal Calculator"
                FontSize="28"
                TextAlignment="Center"
                Margin="0,0,0,24"/>

			<Button Content="Math Calculator"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,12"/>

			<Button Content="Mortgage Calculator"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,12"/>

			<Button Content="Currency Calculator"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,12"/>

			<Button Content="Units Converter"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,12"/>

			<Button Content="Exit"
                    HorizontalAlignment="Stretch"/>
		</StackPanel>
		<Image
			Source="ms-appx:///Assets/abacus.jpg"
			Width="120"
			Height="90"
			Stretch="Uniform"
			HorizontalAlignment="Right"
			VerticalAlignment="Top"
			Margin="0,24,24,0"
			AutomationProperties.Name="Abacus"/>
	</Grid>
</Page>